# =====================================================
# AUDITIONS ADDA - Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control
# =====================================================

# --- Supabase (Required) ---
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# --- Gemini AI (Required for AI Assistant feature) ---
# Get your key from: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# --- App Config (Optional) ---
VITE_APP_URL=http://localhost:3000
VITE_APP_NAME=Auditions Adda

# =====================================================
# QUICK START (Demo mode - no backend needed)
# The app ships with demo login credentials:
#   Actor:    actor@example.com    / password
#   Director: director@example.com / password
#   Admin:    admin@example.com    / password
# For full functionality, connect your Supabase project
# and run supabase-schema-v2-enhanced.sql
# =====================================================
